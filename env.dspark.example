# DeepSeek-V4-Flash-DSpark NVFP4 profile — 2x NVIDIA DGX Spark (GB10, sm_121), vLLM TP=2.
# Verified live 2026-07-10: 1M ctx / seqs 6 / MTP 5 / RoCE RDMA.
# KV pool 2,939,871 tokens @ gpu_mem 0.85; 46.6 tok/s single-stream, 130 tok/s aggregate @ c6.
#
# IMPORTANT: the upstream start script scp's this file to the worker VERBATIM and only
# overrides NODE_RANK/HEADLESS/HF_CACHE/VLLM_HOST_IP per-node. If your worker's RDMA HCA
# has a different name than the head's (ours: head=mlx5_1, worker=rocep1s0f1), you MUST
# also override NCCL_IB_HCA in the worker launch line — see patches/worker-hca-override.patch.
# Without that, NCCL_NET=IB fails on rank 1 ("No device found") and looks like "RoCE is flaky".

# Cluster — replace with your nodes. MASTER_ADDR = HEAD node's fabric/cable IP
# (launch ORDER is worker-first; the rendezvous master is still the head).
WORKER_HOST=<worker-ssh-alias>
WORKER_DIR=
WORKER_SCRIPT_DIR=
MASTER_ADDR=192.168.100.12
MASTER_PORT=25000
NODE_RANK=0
HEADLESS=

# RoCE / InfiniBand (HEAD values; worker HCA is overridden at launch — see patch).
# Exact-match "=name:port" syntax prevents NCCL from grabbing a second HCA on
# another subnet. GID index must be the RoCE v2 + IPv4 entry for the cable IP
# (check /sys/class/infiniband/<hca>/ports/1/gid_attrs/types/).
NCCL_IB_HCA==mlx5_1:1
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_GID_INDEX=3
NCCL_CROSS_NIC=1

# Emergency fallback if RDMA misbehaves (costs ~20-40% throughput):
#   NCCL_IB_DISABLE=1  NCCL_NET=Socket
NCCL_IB_DISABLE=0
NCCL_NET=IB
NCCL_DEBUG=WARN

# Caches / model — ${HOME} expands per-node. Offline flags require the model
# snapshot to be fully cached on BOTH nodes first (run prepare-dspark-model-cache.sh
# once with HF_HUB_OFFLINE=0 on any fresh node).
HF_CACHE=${HOME}/.cache/huggingface
WORKER_HF_CACHE=
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
# CRITICAL: the NVFP4 quant. The official FP8 deepseek-ai/... checkpoint CANNOT run
# on GB10 sm_121 (DeepGEMM asserts "Unsupported architecture"; VLLM_USE_DEEP_GEMM=0
# does not bypass it).
DSPARK_MODEL=fraserprice/DeepSeek-V4-Flash-DSpark

# API
VLLM_PORT=8888
SERVED_MODEL_NAME=deepseek-v4-flash-dspark
VLLM_HOST=0.0.0.0
VLLM_HOST_IP=192.168.100.12
WORKER_VLLM_HOST_IP=192.168.100.13

# Runtime image built by ./build-dspark-vllm-runtime.sh (upstream recipe)
DSPARK_VLLM_IMAGE=vllm-dspark-runtime:dspark-nvfp4-stage-c

# Serving profile — verified 1M lane.
# seqs 12->6 DOUBLED our KV pool (1.44M -> 2.99M tokens).
# MTP=5 needs draft_sample_method=probabilistic (compose default) — greedy drafts
# are the documented cold-start garble root cause. MTP=5 only beats MTP=3 when the
# interconnect is RDMA; on TCP it is throughput-neutral.
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.85
MTP_NUM_TOKENS=5

# DSpark / B12X switches (validated set — do not trim)
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_B12X_MOE=1
VLLM_USE_B12X_WO_PROJECTION=1
VLLM_DSPARK_CONFIDENCE_THRESHOLD=0.0
VLLM_DSPARK_CONFIDENCE_SCHEDULER=off
VLLM_DSPARK_LOCAL_ARGMAX=1
VLLM_DSPARK_REPLICATE_MARKOV_W1=1
VLLM_DSPARK_FUSED_MARKOV_ARGMAX=0
VLLM_DSPARK_GPU_REJECTED_CONTEXT_MASK=1
VLLM_DSPARK_REFERENCE_KV_QUANT_DEQUANT=0
VLLM_DSPARK_HARDWARE_SCHEDULER_EARLY_STOP=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_B12X_W4A16_FORCE_TILE_CONFIG=
B12X_W4A16_TC_DECODE=0
VLLM_DSV4_B12X_COMPRESSED_MLA=0
VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE=0
VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE_EXACT=0
